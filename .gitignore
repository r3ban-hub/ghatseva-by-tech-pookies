*.key
*.pem
secrets.*
.streamlit/secrets.toml

# Generated outputs written to the repo root (re-create with the commands in README).
# Anchored with "/" so templates/ (e.g. a future templates/work_order_en.md) is never ignored.
/out/
/output/
/evidence*.csv
/work_order*.md
/brief_*.md
/*.zip

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Note: data/, config/, templates/ and tests/fixtures/ are source files and must stay tracked.
